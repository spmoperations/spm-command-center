# Copy to .env.local and fill in. .env.local is ignored by git: never commit real keys.

# Encrypts the keys saved from the Connections tab. Create one with: openssl rand -base64 32
SECRETS_KEY=

# Sign-in. One fixed login for now: the email and password typed on the login page.
# Pick a long password; anyone who has it can read every message in the dashboard.
LOGIN_EMAIL=
LOGIN_PASSWORD=

# The hosted database (Supabase): Connect, then the "Session pooler" connection string, with
# the database password in place of [YOUR-PASSWORD]. Leave empty to keep the data in
# ui/.data on this computer. Check it with: npm run db:check
DATABASE_URL=

# Optional: connect on first start without using the Connections tab.
SLACK_USER_TOKEN=
FATHOM_API_KEY=

# App keys (Telegram, Google, the AI) are kept in the database, encrypted, for each person: save
# them on the Connections page under App keys. Set here, they are copied in once on start as the
# owner's keys, and can then be removed. See README, App keys.
#
# Telegram. The two app keys come from https://my.telegram.org, under "API development tools".
# A person then logs in on the Connections tab with their phone number and the code Telegram
# sends. The login is stored encrypted in the database the app uses, like the Slack token.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# With the hosted database, Telegram stays off unless this is true. Set it on the live site
# only. Leave it out on your own machine: then pointing the app at the hosted database can
# never put your own Telegram account there. To use your own account while developing, keep
# the data on your computer with: npm run dev:local
# TELEGRAM_HOSTED=true
# How much the Telegram check reads: days back on the first read, and how many recent chats.
# TELEGRAM_BACKFILL_DAYS=2
# TELEGRAM_MAX_CHATS=30

# Google: Gmail for the inbox and Calendar for the meetings coming up. Read-only. The two keys are
# the Client ID and Client secret of an OAuth client ("Web application") in Google Cloud; see
# docs/google-connection.md. A person then connects one or more accounts with the Connect Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# With the hosted database, Google stays off unless this is true. Set it on the live site only,
# exactly as with TELEGRAM_HOSTED. On your own machine use: npm run dev:local
# GOOGLE_HOSTED=true
# Emails come in from the moment an account is connected. A run opens at most this many threads;
# the rest come in the next run.
# GMAIL_MAX_THREADS=50

# Claude, used only to find tasks in new messages.
ANTHROPIC_API_KEY=
# Needed when the key is not tied to one workspace.
ANTHROPIC_WORKSPACE_ID=
# Defaults to the cheapest current model.
# ANTHROPIC_MODEL=claude-haiku-4-5

# On a host (Vercel): the secret its scheduler sends to GET /api/cron. Any long random text.
# Not needed on your own machine, where the timers run inside the server.
CRON_SECRET=

# Replies and delegation messages stay in the outbox until this is true.
SENDING_ENABLED=false

# Development limits: read only a little.
# With TICKER=off the checks run only when "Run now" is pressed in Settings, Timers.
TICKER=off
SLACK_BACKFILL_DAYS=2
SLACK_MAX_PAGES=6
FATHOM_BACKFILL_DAYS=7
FATHOM_MAX_PAGES=1
AI_MAX_CONVERSATIONS=5
